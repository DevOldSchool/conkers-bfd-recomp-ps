{
  "description": "Every scene with a report: the scene loads from the pause save and plays 30 s in 16:9 (walking, turning the camera) without a crash, a hang, heap damage or a sky buffer overrun",
  "covers": [
    "src/enhancements/pause_save (load and restore)",
    "src/enhancements/display_options/widescreen_culling.cpp",
    "src/enhancements/draw_distance",
    "src/runtime/heap_check.cpp",
    "src/fixes/*",
    "every recompiled hook (tools/regenerate.sh)"
  ],
  "frames": 900,
  "env": {
    "CONKER_TEST_ASPECT": "16:9",
    "CONKER_HEAP_CHECK": "1"
  },
  "switches": {
    "WIDESCREEN": 1
  },
  "input": [
    {
      "at": 60,
      "hold": 90,
      "stick": [
        0,
        80
      ]
    },
    {
      "at": 200,
      "hold": 240,
      "buttons": "CLEFT"
    },
    {
      "at": 480,
      "hold": 60,
      "stick": [
        0,
        -80
      ]
    },
    {
      "at": 560,
      "hold": 240,
      "buttons": "CRIGHT"
    }
  ],
  "expect": [
    {
      "log": "resumed scene state"
    },
    {
      "no_log": "heap damaged"
    },
    {
      "no_log": "sky buffer overrun"
    }
  ],
