+    // rest of the picture left out: fractions of the frame buffer (x, y, width, height). A width or
+    // height of 0 presents the whole picture as usual. Safe to call from any thread; the next
+    // presented frame uses it.
+    struct PresentFocus {
+        float x = 0.0f;
+        float y = 0.0f;
+        float width = 0.0f;
+        float height = 0.0f;
+    };
+
+    void SetPresentFocus(const PresentFocus &focus);
+    PresentFocus GetPresentFocus();
 };
 
