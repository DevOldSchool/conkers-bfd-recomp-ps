+std::vector<std::pair<uint32_t, int64_t>> ultramodern::armed_timers_remaining(RDRAM_ARG1) {
+    std::vector<std::pair<uint32_t, int64_t>> result;
+    std::lock_guard lock{armed_mutex};
+    const uint64_t now = time_now();
+    for (PTR(OSTimer) t_ : armed_timers) {
+        const OSTimer* t = TO_PTR(OSTimer, t_);
+        result.emplace_back(static_cast<uint32_t>(t_), static_cast<int64_t>(t->timestamp) - static_cast<int64_t>(now));
+    }
+    return result;
+}
+
+void ultramodern::replace_timers(RDRAM_ARG const std::vector<std::pair<uint32_t, int64_t>>& timers) {
+    std::lock_guard lock{armed_mutex};
+    for (PTR(OSTimer) t_ : armed_timers) {
+        timer_context.action_queue.enqueue(RemoveTimerAction{ t_ });
+    }
+    armed_timers.clear();
+    const uint64_t now = time_now();
+    for (const auto& [t_, remaining] : timers) {
+        OSTimer* t = TO_PTR(OSTimer, static_cast<PTR(OSTimer)>(t_));
+        t->timestamp = static_cast<OSTime>(static_cast<int64_t>(now) + remaining);
+        armed_timers.insert(static_cast<PTR(OSTimer)>(t_));
+        timer_context.action_queue.enqueue(AddTimerAction{ static_cast<PTR(OSTimer)>(t_) });
+    }
+}
