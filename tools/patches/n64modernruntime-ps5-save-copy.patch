+// Copies `from` over `to`. A file the game does not own (on a PS5, one put there over FTP belongs to
+// root) can't take the copy's permissions, so the copy fails; it is then deleted and copied again.
+static bool replace_file(const std::filesystem::path& from, const std::filesystem::path& to) {
+    std::error_code ec;
+    std::filesystem::copy_file(from, to, std::filesystem::copy_options::overwrite_existing, ec);
+    if (!ec) {
+        return true;
+    }
+    std::filesystem::remove(to, ec);
+    ec.clear();
+    std::filesystem::copy_file(from, to, ec);
+    return !ec;
+}
