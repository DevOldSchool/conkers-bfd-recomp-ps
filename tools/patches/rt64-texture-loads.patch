 #include "../include/rt64_extended_gbi.h"
@@ -555,4 +556,27 @@ namespace RT64 {
     }
 
+    void RDP::resetLoadBudget() {
+        loadWordsLeft = LoadWordBudget;
+    }
+
+    // Takes the words a load copies into TMEM from this task's budget. A display list from game memory
+    // can repeat large loads millions of times; past the budget they are skipped rather than spending
+    // minutes on them.
+    bool RDP::takeLoadBudget(uint64_t words) {
+        if (words > loadWordsLeft) {
+            static bool reported = false;
+            if (!reported) {
+                reported = true;
+                fprintf(stderr, "RT64: texture loads past %llu words in one task are skipped\n", (unsigned long long)(LoadWordBudget));
+            }
+
+            loadWordsLeft = 0;
+            return false;
+        }
+
+        loadWordsLeft -= words;
+        return true;
+    }
+
