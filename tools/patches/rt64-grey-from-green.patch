+    // Puts the green channel in all three for the whole target: a copy of it is drawn back over it.
+    void RenderTarget::greyFromGreen(RenderWorker *worker, const ShaderLibrary *shaderLibrary) {
+        assert(worker != nullptr);
+        if (isEmpty() || (format != colorBufferFormat(usesHDR))) {
+            return;
+        }
+
+        TextureCopyDescriptorSet *sourceDescSet = nullptr;
+        RenderTexture *sourceTexture = nullptr;
+        if (usesResolve()) {
+            resolveTarget(worker, shaderLibrary);
+            if (greyResolvedDescSet == nullptr) {
+                greyResolvedDescSet = std::make_unique<TextureCopyDescriptorSet>(worker->device);
+                greyResolvedDescSet->setTexture(greyResolvedDescSet->gInput, resolvedTexture.get(), RenderTextureLayout::SHADER_READ, resolvedTextureView.get());
+            }
+
+            sourceDescSet = greyResolvedDescSet.get();
+            sourceTexture = resolvedTexture.get();
+        }
+        else {
+            if ((greyTexture == nullptr) || (greyTextureWidth != width) || (greyTextureHeight != height)) {
+                greyDescSet.reset();
+                greyTextureView.reset();
+                greyTexture = worker->device->createTexture(RenderTextureDesc::Texture2D(width, height, 1, format));
+                greyTextureView = greyTexture->createTextureView(RenderTextureViewDesc::Texture2D(format));
+                greyDescSet = std::make_unique<TextureCopyDescriptorSet>(worker->device);
+                greyDescSet->setTexture(greyDescSet->gInput, greyTexture.get(), RenderTextureLayout::SHADER_READ, greyTextureView.get());
+                greyTextureWidth = width;
+                greyTextureHeight = height;
+            }
+
+            RenderTextureBarrier copyBarriers[] = {
+                RenderTextureBarrier(texture.get(), RenderTextureLayout::COPY_SOURCE),
+                RenderTextureBarrier(greyTexture.get(), RenderTextureLayout::COPY_DEST)
+            };
+
+            worker->commandList->barriers(RenderBarrierStage::COPY, copyBarriers, uint32_t(std::size(copyBarriers)));
+            worker->commandList->copyTexture(greyTexture.get(), texture.get());
+            sourceDescSet = greyDescSet.get();
+            sourceTexture = greyTexture.get();
+        }
+
+        RenderTextureBarrier drawBarriers[] = {
+            RenderTextureBarrier(texture.get(), RenderTextureLayout::COLOR_WRITE),
+            RenderTextureBarrier(sourceTexture, RenderTextureLayout::SHADER_READ)
+        };
+
+        worker->commandList->barriers(RenderBarrierStage::GRAPHICS, drawBarriers, uint32_t(std::size(drawBarriers)));
+        setupColorFramebuffer(worker);
+        worker->commandList->setFramebuffer(textureFramebuffer.get());
+
+        interop::TextureCopyCB textureCopyCB;
+        textureCopyCB.uvScroll.x = 0.0f;
+        textureCopyCB.uvScroll.y = 0.0f;
+        textureCopyCB.uvScale.x = float(width);
+        textureCopyCB.uvScale.y = float(height);
+
+        const ShaderRecord &greyFromGreen = shaderLibrary->greyFromGreen;
+        worker->commandList->setPipeline(greyFromGreen.pipeline.get());
+        worker->commandList->setGraphicsPipelineLayout(greyFromGreen.pipelineLayout.get());
+        worker->commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        worker->commandList->setViewports(RenderViewport(0.0f, 0.0f, float(width), float(height)));
+        worker->commandList->setScissors(RenderRect(0, 0, width, height));
+        worker->commandList->setGraphicsDescriptorSet(sourceDescSet->get(), 0);
+        worker->commandList->setGraphicsPushConstants(0, &textureCopyCB);
+        worker->commandList->drawInstanced(3, 1, 0, 0);
+
+        markForResolve();
+    }
