diff --git a/src/shaders/GreyFromGreenPS.hlsl b/src/shaders/GreyFromGreenPS.hlsl
new file mode 100644
--- /dev/null
+++ b/src/shaders/GreyFromGreenPS.hlsl
@@ -0,0 +1,18 @@
+//
+// RT64
+//
+
+#include "shared/rt64_texture_copy.h"
+
+// A copy of a colour target with its green channel in all three: Conker's black and white
+// (a CPU pass over the frame on the N64 that copies each pixel's green bits into red and blue).
+
+[[vk::push_constant]] ConstantBuffer<TextureCopyCB> gConstants : register(b0);
+
+Texture2D<float4> gInput : register(t1);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    uint2 pixelPos = gConstants.uvScroll + uv.xy * gConstants.uvScale;
+    float4 color = gInput.Load(uint3(pixelPos, 0));
+    return float4(color.ggg, color.a);
+}
