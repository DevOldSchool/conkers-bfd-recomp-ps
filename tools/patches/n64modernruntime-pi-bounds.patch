+// A transfer's device address and size come from the game, and so from game memory: one that runs
+// outside the ROM (or save) would read the host's own memory. Stop instead.
+[[noreturn]] static void bad_transfer(const char* what, uint32_t physical_addr, size_t num_bytes) {
+    fprintf(stderr, "[ultramodern] A %s of 0x%zX bytes at 0x%08X runs outside the cartridge: the game's memory is not one "
+                    "this run can trust. Stopping.\n", what, num_bytes, physical_addr);
+    ULTRAMODERN_QUICK_EXIT();
+}
+
+static bool rom_range_ok(uint32_t physical_addr, size_t num_bytes) {
+    if (physical_addr < recomp::rom_base) {
+        return false;
+    }
+    const size_t offset = physical_addr - recomp::rom_base;
+    return offset <= rom.size() && num_bytes <= rom.size() - offset;
+}
+
 void recomp::do_rom_read(uint8_t* rdram, gpr ram_address, uint32_t physical_addr, size_t num_bytes) {
+    if (!rom_range_ok(physical_addr, num_bytes)) {
+        bad_transfer("ROM read", physical_addr, num_bytes);
+    }
+
     // TODO use word copies when possible
 
