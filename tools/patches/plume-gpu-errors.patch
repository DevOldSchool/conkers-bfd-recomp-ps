+    // Reports the command buffer to the error callback if the GPU fails it, with the encoders that
+    // faulted (begin asks for their execution status).
+    static void reportCommandBufferErrors(MTL::CommandBuffer *cmdBuffer, const std::string &queueName) {
+        if (renderCommandErrorCallback().load() == nullptr) {
+            return;
+        }
+
+        cmdBuffer->addCompletedHandler([queueName](MTL::CommandBuffer *buffer) {
+            const RenderCommandErrorCallback callback = renderCommandErrorCallback().load();
+            if ((callback == nullptr) || (buffer->status() != MTL::CommandBufferStatusError)) {
+                return;
+            }
+
+            NS::Error *error = buffer->error();
+            std::string description = "no description";
+            std::map<std::string, int> faulted;
+            int64_t code = 0;
+            if (error != nullptr) {
+                code = error->code();
+                if (error->localizedDescription() != nullptr) {
+                    description = error->localizedDescription()->utf8String();
+                }
+
+                NS::Dictionary *userInfo = error->userInfo();
+                NS::Array *encoderInfos = (userInfo != nullptr) ? userInfo->object<NS::Array>(MTL::CommandBufferEncoderInfoErrorKey) : nullptr;
+                for (NS::UInteger i = 0; (encoderInfos != nullptr) && (i < encoderInfos->count()); i++) {
+                    MTL::CommandBufferEncoderInfo *info = encoderInfos->object<MTL::CommandBufferEncoderInfo>(i);
+                    if (info->errorState() == MTL::CommandEncoderErrorStateFaulted) {
+                        faulted[(info->label() != nullptr) ? info->label()->utf8String() : "unlabelled encoder"]++;
+                    }
+                }
+            }
+
+            std::string faultedEncoders;
+            for (const auto &[label, count] : faulted) {
+                faultedEncoders += (faultedEncoders.empty() ? "" : ", ") + label + " x" + std::to_string(count);
+            }
+
+            callback({ queueName.c_str(), code, description.c_str(), faultedEncoders.empty() ? "none reported" : faultedEncoders.c_str() });
+        });
+    }
+
