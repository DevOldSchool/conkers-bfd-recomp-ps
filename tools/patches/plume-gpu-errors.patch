+    // A command buffer the GPU failed (Metal only): the name of the queue it was sent on, the error's
+    // code and description, and the labels of the encoders that faulted, each with how many there were.
+    struct RenderCommandError {
+        const char *queueName;
+        int64_t code;
+        const char *description;
+        const char *faultedEncoders;
+    };
+
+    // Called on a driver thread for each failed command buffer, when set.
+    using RenderCommandErrorCallback = void (*)(const RenderCommandError &error);
+
+    inline std::atomic<RenderCommandErrorCallback> &renderCommandErrorCallback() {
+        static std::atomic<RenderCommandErrorCallback> callback{ nullptr };
+        return callback;
+    }
