+// Set by the game to supply osGetCount itself (for repeatable runs); returns false to use the clock.
+extern "C" bool (*recomp_get_count_override)(uint32_t* count) = nullptr;
+
 extern "C" void osGetCount_recomp(uint8_t * rdram, recomp_context * ctx) {
+    uint32_t count;
+    if (recomp_get_count_override != nullptr && recomp_get_count_override(&count)) {
+        ctx->r2 = (int32_t)count;
+        return;
+    }
     ctx->r2 = osGetCount();
 }
 
