diff --git a/src/gbi/rt64_gbi_f3dex2cbfd.cpp b/src/gbi/rt64_gbi_f3dex2cbfd.cpp
new file mode 100644
index 0000000..78418d6
--- /dev/null
+++ b/src/gbi/rt64_gbi_f3dex2cbfd.cpp
@@ -0,0 +1,117 @@
+//
+// RT64
+//
+
+#include "rt64_gbi_f3dex2cbfd.h"
+
+#include "hle/rt64_interpreter.h"
+
+#include "rt64_gbi_f3dex2.h"
+
+// F3DEX2CBFD is Rare's modification of F3DEX2 2.08 for Conker's Bad Fur Day. The command set is
+// F3DEX2's with these differences (reference: GLideN64's F3DEX2CBFD.cpp):
+//
+// - VTX: same fields, but the vertex color is always a color. Normals X/Y come from a separate
+//   stream set with MOVEMEM 0x0E, normal Z is the low byte of the vertex flag.
+// - MOVEWORD NUMLIGHT counts 48-byte light records, index 0x10 sets the coordinate modifiers.
+// - MOVEMEM LIGHT offsets are in units of 48 bytes; records carry a position and attenuation.
+// - LOAD_UCODE switches to the "advanced" lighting path instead of loading a microcode.
+// - Opcodes 0x10 to 0x1F draw four triangles with 5-bit vertex indices.
+
+namespace RT64 {
+    namespace GBI_F3DEX2CBFD {
+        void vertex(State *state, DisplayList **dl) {
+            const uint8_t vtxCount = (*dl)->p0(12, 8);
+            state->rsp->setVertexCBFD((*dl)->w1, vtxCount, (*dl)->p0(1, 7) - vtxCount);
+        }
+
+        void moveMem(State *state, DisplayList **dl) {
+            const uint8_t index = (*dl)->p0(0, 8);
+            switch (index) {
+            case F3DEX2_G_MV_VIEWPORT:
+                state->rsp->setViewport((*dl)->w1);
+                break;
+            case F3DEX2_G_MV_LIGHT: {
+                const uint32_t offset = (*dl)->p0(5, 14);
+                const uint32_t lightIndex = offset / 48;
+                if (lightIndex < 2) {
+                    state->rsp->setLookAt(lightIndex, (*dl)->w1);
+                }
+                else {
+                    state->rsp->setLightCBFD(lightIndex - 2, (*dl)->w1);
+                }
+
+                break;
+            }
+            case F3DEX2CBFD_G_MV_NORMALS:
+                state->rsp->setNormalBaseCBFD((*dl)->w1);
+                break;
+            default:
+                break;
+            }
+        }
+
+        void moveWord(State *state, DisplayList **dl) {
+            const uint8_t type = (*dl)->p0(16, 8);
+            switch (type) {
+            case G_MW_NUMLIGHT:
+                state->rsp->setLightCountCBFD((*dl)->w1 / 48);
+                break;
+            case G_MW_LIGHTCOL:
+                state->rsp->setLightColorCBFD((*dl)->p0(0, 16), (*dl)->w1);
+                break;
+            case F3DEX2CBFD_G_MW_COORD_MOD:
+                state->rsp->setCoordModCBFD((*dl)->w0, (*dl)->w1);
+                break;
+            default:
+                GBI_F3DEX2::moveWord(state, dl);
+                break;
+            }
+        }
+
+        void switchLightingMode(State *state, DisplayList **dl) {
+            state->rsp->setAdvancedLightingCBFD(true);
+        }
+
+        void tri4(State *state, DisplayList **dl) {
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            const uint32_t idx[12] = {
+                (w0 >> 23) & 0x1F, (w0 >> 18) & 0x1F, (((w0 >> 15) & 0x7) << 2) | ((w1 >> 30) & 0x3),
+                (w0 >> 10) & 0x1F, (w0 >> 5) & 0x1F, w0 & 0x1F,
+                (w1 >> 25) & 0x1F, (w1 >> 20) & 0x1F, (w1 >> 15) & 0x1F,
+                (w1 >> 10) & 0x1F, (w1 >> 5) & 0x1F, w1 & 0x1F
+            };
+
+            for (uint32_t t = 0; t < 4; t++) {
+                const uint32_t a = idx[t * 3 + 0], b = idx[t * 3 + 1], c = idx[t * 3 + 2];
+                // Unused slots are encoded as (0, 0, 0).
+                if ((a == b) && (b == c)) {
+                    continue;
+                }
+
+                state->rsp->drawIndexedTri(a, b, c);
+            }
+        }
+
+        void reset(State *state) {
+            state->rsp->setClipRatioAll(2U);
+            state->rsp->resetCBFD();
+        }
+
+        void setup(GBI *gbi) {
+            GBI_F3DEX2::setup(gbi);
+
+            gbi->map[F3DEX2_G_VTX] = &vertex;
+            gbi->map[F3DEX2_G_MOVEMEM] = &moveMem;
+            gbi->map[F3DEX2_G_MOVEWORD] = &moveWord;
+            gbi->map[F3DEX2_G_LOAD_UCODE] = &switchLightingMode;
+            for (uint32_t i = 0; i < 16; i++) {
+                gbi->map[F3DEX2CBFD_G_TRI4 + i] = &tri4;
+            }
+
+            gbi->resetFromTask = &reset;
+            gbi->resetFromLoad = &reset;
+        }
+    }
+};
