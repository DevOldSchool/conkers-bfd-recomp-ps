+    // F3DEX2CBFD
+
+    void RSP::setVertexCBFD(uint32_t address, uint32_t vtxCount, uint32_t dstIndex) {
+        // Same vertex layout as F3DEX2. The difference is how lit vertices get their normals, which
+        // setVertexCommon handles through lightVerticesCBFD.
+        setVertex(address, vtxCount, dstIndex);
+    }
+
+    void RSP::setLightCBFD(uint32_t index, uint32_t address) {
+        if (index > RSP_CBFD_MAX_LIGHTS) {
+            return;
+        }
+
+        // 48-byte record: color at +0, second color at +4, direction at +8, attenuation at +12 and
+        // a 16-bit position at +32.
+        const uint32_t rdramAddress = fromSegmentedMasked(address);
+        const uint8_t *RDRAM = state->RDRAM;
+        auto readU8 = [&](uint32_t offset) { return RDRAM[(rdramAddress + offset) ^ 3]; };
+        auto readS8 = [&](uint32_t offset) { return int8_t(RDRAM[(rdramAddress + offset) ^ 3]); };
+        auto readS16 = [&](uint32_t offset) { return *reinterpret_cast<const int16_t *>(&RDRAM[(rdramAddress + offset) ^ 2]); };
+        CBFDLight &light = cbfd.lights[index];
+        light.col = { readU8(0) / 255.0f, readU8(1) / 255.0f, readU8(2) / 255.0f };
+        const hlslpp::float3 dir = { float(readS8(8)), float(readS8(9)), float(readS8(10)) };
+        const float dirLength = hlslpp::length(dir);
+        light.dir = (dirLength > 0.0f) ? (dir / dirLength) : dir;
+        light.pos = { float(readS16(32)), float(readS16(34)), float(readS16(36)) };
+        light.ca = readU8(12) / 16.0f;
+    }
+
+    void RSP::setLightColorCBFD(uint32_t offset, uint32_t value) {
+        const uint32_t index = offset / 48;
+        if ((index > RSP_CBFD_MAX_LIGHTS) || ((offset % 48) != 0)) {
+            return;
+        }
+
+        cbfd.lights[index].col = { ((value >> 24) & 0xFF) / 255.0f, ((value >> 16) & 0xFF) / 255.0f, ((value >> 8) & 0xFF) / 255.0f };
+    }
+
+    void RSP::setLightCountCBFD(uint32_t count) {
+        cbfd.lightCount = std::min(int(count), RSP_CBFD_MAX_LIGHTS);
+    }
+
+    void RSP::setNormalBaseCBFD(uint32_t address) {
+        cbfd.normalBase = fromSegmentedMasked(address);
+    }
+
+    void RSP::setCoordModCBFD(uint32_t w0, uint32_t w1) {
+        if ((w0 & 0x8) != 0) {
+            return;
+        }
+
+        auto &mod = cbfd.coordMod;
+        const uint32_t idx = (w0 >> 1) & 0x3;
+        const uint32_t pos = w0 & 0x30;
+        if (pos == 0x00) {
+            mod[0 + idx] = float(int16_t(w1 >> 16));
+            mod[1 + idx] = float(int16_t(w1 & 0xFFFF));
+        }
+        else if (pos == 0x10) {
+            mod[4 + idx] = (w1 >> 16) / 65536.0f;
+            mod[5 + idx] = (w1 & 0xFFFF) / 65536.0f;
+            mod[12 + idx] = mod[0 + idx] + mod[4 + idx];
+            mod[13 + idx] = mod[1 + idx] + mod[5 + idx];
+        }
+        else if (pos == 0x20) {
+            mod[8 + idx] = float(int16_t(w1 >> 16));
+            mod[9 + idx] = float(int16_t(w1 & 0xFFFF));
+        }
+    }
+
+    void RSP::setAdvancedLightingCBFD(bool enabled) {
+        cbfd.advancedLighting = enabled;
+    }
+
+    void RSP::resetCBFD() {
+        cbfd.lights.fill({});
+        cbfd.lightCount = 0;
+        cbfd.advancedLighting = false;
+    }
+
+    void RSP::lightVerticesCBFD(uint32_t dstIndex, uint32_t dstMax, uint32_t globalIndex) {
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        auto &normColBytes = workload.drawData.normColBytes;
+        auto &lightIndices = workload.drawData.lightIndices;
+        auto &lightCounts = workload.drawData.lightCounts;
+        auto &rspLights = workload.drawData.rspLights;
+        const auto &posTransformed = workload.drawData.posTransformed;
+        const uint32_t &geometryMode = geometryModeStack[geometryModeStackSize - 1];
+        const bool pointLightingNormals = (geometryMode & G_POINT_LIGHTING) != 0;
+        const uint32_t textureGenMask = G_LIGHTING | G_TEXTURE_GEN;
+        const bool usesTextureGen = (geometryMode & textureGenMask) == textureGenMask;
+        const uint8_t *RDRAM = state->RDRAM;
+        const auto &mod = cbfd.coordMod;
+        const int lightCount = cbfd.lightCount;
+
+        // Light directions in model space (inverse of the modelview rotation).
+        const hlslpp::float4x4 &modelView = modelMatrixStack[modelMatrixStackSize - 1];
+        std::array<hlslpp::float3, RSP_CBFD_MAX_LIGHTS + 1> modelDirs;
+        for (int l = 0; l < lightCount; l++) {
+            const hlslpp::float3 dir = hlslpp::mul(modelView, hlslpp::float4(cbfd.lights[l].dir, 0.0f)).xyz;
+            const float dirLength = hlslpp::length(dir);
+            modelDirs[l] = (dirLength > 0.0f) ? (dir / dirLength) : dir;
+        }
+
+        // Matches std::min(1.0f, x) in GLideN64, including x being NaN.
+        auto clampIntensity = [](float x) { return (x < 1.0f) ? x : 1.0f; };
+        auto pointIntensity = [&](int l, const hlslpp::float3 &vPos) {
+            const hlslpp::float3 d = vPos - cbfd.lights[l].pos;
+            const float len = 2.0f * hlslpp::dot(d, d) / 65536.0f;
+            return clampIntensity(cbfd.lights[l].ca / len);
+        };
+
+        for (uint32_t i = dstIndex; i < dstMax; i++) {
+            const Vertex &v = vertices[i];
+            const uint32_t g = globalIndex + (i - dstIndex);
+            const int8_t nx = int8_t(RDRAM[(cbfd.normalBase + i * 2 + 0) ^ 3]);
+            const int8_t ny = int8_t(RDRAM[(cbfd.normalBase + i * 2 + 1) ^ 3]);
+            const int8_t nz = int8_t(v.flag & 0xFF);
+            const hlslpp::float3 normal = { nx / 127.0f, ny / 127.0f, nz / 127.0f };
+            hlslpp::float3 color = { v.color.r / 255.0f, v.color.g / 255.0f, v.color.b / 255.0f };
+
+            // Vertices with the top flag bit set keep their color.
+            if (int16_t(v.flag) >= 0) {
+                const hlslpp::float4 &tf = posTransformed[g];
+                const hlslpp::float3 vPos = {
+                    (float(tf.x) + mod[8]) * mod[12],
+                    (float(tf.y) + mod[9]) * mod[13],
+                    (float(tf.z) + mod[10]) * mod[14]
+                };
+
+                hlslpp::float3 light = cbfd.lights[lightCount].col;
+                int l = lightCount - 1;
+                if (cbfd.advancedLighting && (l >= 0)) {
+                    const float intensity = clampIntensity(hlslpp::dot(normal, modelDirs[l]));
+                    if (intensity > 0.0f) {
+                        light += cbfd.lights[l].col * intensity;
+                    }
+
+                    while (--l >= 0) {
+                        float intensity = pointIntensity(l, vPos);
+                        if (pointLightingNormals) {
+                            intensity *= clampIntensity(hlslpp::dot(normal, modelDirs[l]));
+                        }
+
+                        if (intensity > 0.0f) {
+                            light += cbfd.lights[l].col * intensity;
+                        }
+                    }
+                }
+                else if (!cbfd.advancedLighting) {
+                    for (l = lightCount - 2; l >= 0; l--) {
+                        const float intensity = pointIntensity(l, vPos);
+                        if (intensity > 0.0f) {
+                            light += cbfd.lights[l].col * intensity;
+                        }
+                    }
+                }
+
+                color *= hlslpp::min(light, hlslpp::float3(1.0f, 1.0f, 1.0f));
+            }
+
+            // Without texgen the lit color is the vertex color and the GPU does no lighting. With
+            // texgen the shader reads the same bytes as the normal, so the vertex carries its normal
+            // and the lit color reaches the shader as a per-vertex ambient light.
+            if (usesTextureGen && (rspLights.size() < 0xFFFF)) {
+                normColBytes[g * 4 + 0] = uint8_t(nx);
+                normColBytes[g * 4 + 1] = uint8_t(ny);
+                normColBytes[g * 4 + 2] = uint8_t(nz);
+                interop::RSPLight rspLight = {};
+                rspLight.col = color;
+                lightIndices[g] = uint16_t(rspLights.size());
+                lightCounts[g] = 1;
+                rspLights.push_back(rspLight);
+            }
+            else {
+                normColBytes[g * 4 + 0] = uint8_t(std::lround(float(color.x) * 255.0f));
+                normColBytes[g * 4 + 1] = uint8_t(std::lround(float(color.y) * 255.0f));
+                normColBytes[g * 4 + 2] = uint8_t(std::lround(float(color.z) * 255.0f));
+                lightIndices[g] = 0;
+                lightCounts[g] = 0;
+            }
+        }
+    }
 };
