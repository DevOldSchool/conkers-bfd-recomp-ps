diff --git a/librecomp/include/librecomp/save_file_name.hpp b/librecomp/include/librecomp/save_file_name.hpp
new file mode 100644
index 0000000..78be30a
--- /dev/null
+++ b/librecomp/include/librecomp/save_file_name.hpp
@@ -0,0 +1,24 @@
+#ifndef __RECOMP_SAVE_FILE_NAME_HPP__
+#define __RECOMP_SAVE_FILE_NAME_HPP__
+
+#include <string>
+
+namespace recomp::mods {
+    // A mod's save file name becomes a file name in the mod's save folder, so it may only be letters,
+    // digits, '_' and '-': no separators, no "..", nothing absolute, which would let a mod write a
+    // file anywhere.
+    inline bool save_file_name_ok(const std::string& name) {
+        if (name.empty() || name.size() > 64) {
+            return false;
+        }
+        for (char c : name) {
+            bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
+            if (!ok) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
+
+#endif
