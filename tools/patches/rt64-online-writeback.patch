@@ -115,6 +117,12 @@ namespace RT64 {
         uint32_t displayListAddress;
         uint64_t displayListCounter;
         bool rdramCheckPending;
+        // Images drawn to RAM that start below this RDRAM address are not written back. What the GPU draws
+        // differs between machines, and a game that reads it back (Conker's camera reads depth) then
+        // plays differently on each: online play in lockstep keeps game memory free of it. 0: no limit.
+        std::atomic<uint32_t> protectedRDRAMEnd{ 0 };
+        std::atomic<uint32_t> protectedWritesSkipped{ 0 };
+        std::atomic<uint32_t> protectedLastSkipped{ 0 };
         uint32_t lastWorkloadIndex;
