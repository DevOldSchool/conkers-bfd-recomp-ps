+                        }
+
+                        if ((depthWriteWidth > 0) && mayWrite(depthFb)) {
                             depthFb->copyNativeToRAM(&RDRAM[depthFb->addressStart], depthWriteWidth, depthRowStart, std::min(depthRowEnd, depthFb->height));
                         }
                     }
