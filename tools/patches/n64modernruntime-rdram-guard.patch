diff --git a/librecomp/include/librecomp/addresses.hpp b/librecomp/include/librecomp/addresses.hpp
--- a/librecomp/include/librecomp/addresses.hpp
+++ b/librecomp/include/librecomp/addresses.hpp
@@ -10,6 +10,8 @@ namespace recomp {
     constexpr size_t mem_size = 512ULL * 1024ULL * 1024ULL;
     // 4GB (the full address space)
     constexpr size_t allocation_size = 4096ULL * 1024ULL * 1024ULL;
+    // Inaccessible memory reserved below and above the 4GB, past the furthest a 16-bit offset reaches
+    constexpr size_t rdram_guard_size = 64ULL * 1024ULL;
     // We need a place in rdram to hold the PI handles, so pick an address in extended rdram
     constexpr int32_t cart_handle = 0x80800000;
     constexpr int32_t drive_handle = (int32_t)(cart_handle + sizeof(OSPiHandle));
diff --git a/librecomp/src/recomp.cpp b/librecomp/src/recomp.cpp
--- a/librecomp/src/recomp.cpp
+++ b/librecomp/src/recomp.cpp
@@ -936,24 +936,32 @@ void recomp::start(const recomp::Configuration& cfg) {
     uint8_t* rdram;
     bool alloc_failed;
 #ifdef _WIN32
-    rdram = reinterpret_cast<uint8_t*>(VirtualAlloc(nullptr, allocation_size, MEM_COMMIT | MEM_RESERVE, PAGE_NOACCESS));
+    // A recompiled access adds a signed 16-bit offset to a sign-extended 32-bit pointer without
+    // wrapping, so it can land up to 32 KiB past either end of the 4 GiB. Inaccessible guards
+    // there make such an access fault instead of reaching whatever is mapped next to rdram.
+    uint8_t* reservation = reinterpret_cast<uint8_t*>(VirtualAlloc(nullptr, allocation_size + 2 * rdram_guard_size, MEM_COMMIT | MEM_RESERVE, PAGE_NOACCESS));
+    rdram = reservation + rdram_guard_size;
     DWORD old_protect = 0;
-    alloc_failed = (rdram == nullptr);
+    alloc_failed = (reservation == nullptr);
     if (!alloc_failed) {
         // VirtualProtect returns 0 on failure.
         alloc_failed = (VirtualProtect(rdram, mem_size, PAGE_READWRITE, &old_protect) == 0);
         if (alloc_failed) {
-            VirtualFree(rdram, 0, MEM_RELEASE);
+            VirtualFree(reservation, 0, MEM_RELEASE);
         }
     }
 #else
-    rdram = (uint8_t*)mmap(NULL, allocation_size, PROT_NONE, MAP_ANON | MAP_PRIVATE, -1, 0);
-    alloc_failed = rdram == reinterpret_cast<uint8_t*>(MAP_FAILED);
+    // A recompiled access adds a signed 16-bit offset to a sign-extended 32-bit pointer without
+    // wrapping, so it can land up to 32 KiB past either end of the 4 GiB. Inaccessible guards
+    // there make such an access fault instead of reaching whatever is mapped next to rdram.
+    uint8_t* reservation = (uint8_t*)mmap(NULL, allocation_size + 2 * rdram_guard_size, PROT_NONE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    alloc_failed = reservation == reinterpret_cast<uint8_t*>(MAP_FAILED);
+    rdram = reservation + rdram_guard_size;
     if (!alloc_failed) {
         // mprotect returns -1 on failure.
         alloc_failed = (mprotect(rdram, mem_size, PROT_READ | PROT_WRITE) == -1);
         if (alloc_failed) {
-            munmap(rdram, allocation_size);
+            munmap(reservation, allocation_size + 2 * rdram_guard_size);
         }
     }
 #endif
