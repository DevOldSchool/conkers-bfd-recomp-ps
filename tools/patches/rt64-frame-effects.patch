+    void FramebufferManager::frameEffect(RenderWorker *renderWorker, const FramebufferOperation &op, RenderTargetManager &targetManager, const ShaderLibrary *shaderLibrary) {
+        const uint32_t address = (op.type == FramebufferOperation::Type::FrameMosaic) ? op.frameMosaic.address : op.frameLens.address;
+        auto it = framebuffers.find(address);
+        if ((it == framebuffers.end()) || (it->second.lastWriteType != Framebuffer::Type::Color) || (it->second.width == 0)) {
+            return;
+        }
+
+        RenderTargetKey targetKey(it->second.addressStart, it->second.width, it->second.siz, it->second.lastWriteType);
