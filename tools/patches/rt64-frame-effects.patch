diff --git a/src/shaders/FrameLensPS.hlsl b/src/shaders/FrameLensPS.hlsl
new file mode 100644
--- /dev/null
+++ b/src/shaders/FrameLensPS.hlsl
@@ -0,0 +1,29 @@
+//
+// RT64
+//
+
+#include "shared/rt64_frame_effects.h"
+
+// Conker's sight lens (func_151CB110 on the N64): a disc that magnifies what is around its middle.
+// A point at d (in radii from the middle) shows the point at d * (1 - strength * sqrt(1 - d.y^2) *
+// sqrt(1 - |d|^2)), as the N64 does pixel by pixel from a 24x24 copy, here at every target pixel.
+
+[[vk::push_constant]] ConstantBuffer<FrameLensCB> gConstants : register(b0);
+
+Texture2D<float4> gInput : register(t1);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    uint width, height;
+    gInput.GetDimensions(width, height);
+    const float2 nativePos = (pos.xy - gConstants.origin) / gConstants.scale;
+    const float2 d = (nativePos - gConstants.center) / gConstants.radius;
+    const float lengthSquared = dot(d, d);
+    if (lengthSquared >= 1.0f) {
+        return gInput.Load(uint3(uint2(pos.xy), 0));
+    }
+
+    const float reach = 1.0f - gConstants.strength * sqrt(1.0f - d.y * d.y) * sqrt(1.0f - lengthSquared);
+    const float2 sourcePos = gConstants.source + d * reach * gConstants.radius;
+    const float2 targetPos = gConstants.origin + sourcePos * gConstants.scale;
+    return gInput.Load(uint3(clamp(uint2(max(targetPos, 0.0f)), uint2(0, 0), uint2(width - 1, height - 1)), 0));
+}
diff --git a/src/shaders/FrameMosaicPS.hlsl b/src/shaders/FrameMosaicPS.hlsl
new file mode 100644
--- /dev/null
+++ b/src/shaders/FrameMosaicPS.hlsl
@@ -0,0 +1,38 @@
+//
+// RT64
+//
+
+#include "shared/rt64_frame_effects.h"
+
+// Conker's mosaic (func_150CE450 on the N64): inside a rectangle, each pixel takes a source pixel
+// that steps on once every 0x10000 / step pixels, both across and down, so the rectangle shows
+// blocks of one colour. The blocks are the N64's; each takes the middle of its native source pixel.
+
+[[vk::push_constant]] ConstantBuffer<FrameMosaicCB> gConstants : register(b0);
+
+Texture2D<float4> gInput : register(t1);
+
+// The source of pixel i in a run starting at start: the pixel where the step last carried over.
+uint mosaicSource(uint i, uint start, uint step) {
+    const uint carries = ((i - start) * step) >> 16;
+    if (carries == 0) {
+        return start;
+    }
+
+    return start - 1 + ((carries << 16) + step - 1) / step;
+}
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    uint width, height;
+    gInput.GetDimensions(width, height);
+    const int2 nativePos = int2(floor((pos.xy - gConstants.origin) / gConstants.scale));
+    const uint4 rect = gConstants.rect;
+    if (any(nativePos < int2(rect.xy)) || any(nativePos > int2(rect.zw))) {
+        return gInput.Load(uint3(uint2(pos.xy), 0));
+    }
+
+    const uint step = min(gConstants.step, 0x10000U);
+    const uint2 sourcePos = uint2(mosaicSource(uint(nativePos.x), rect.x, step), mosaicSource(uint(nativePos.y), rect.y, step));
+    const float2 targetPos = gConstants.origin + (float2(sourcePos) + 0.5f) * gConstants.scale;
+    return gInput.Load(uint3(clamp(uint2(targetPos), uint2(0, 0), uint2(width - 1, height - 1)), 0));
+}
