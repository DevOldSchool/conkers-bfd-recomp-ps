+// rdram's address space on the console (see recomp::start): the layout the other platforms make with
+// mmap, as a kernel reservation backed by direct memory. Returns rdram, the reservation past its
+// first guard, or nullptr with everything it did undone.
+static uint8_t* ps5_reserve_rdram() {
+    using namespace recomp;
+    const size_t total = allocation_size + 2 * rdram_guard_size;
+    // Clear of the Vulkan driver's two regions (its GPU ring at 0x200000000-0x2FFFFFFFF, its device
+    // memory from 0x4000000000): without them it has no device.
+    static const uintptr_t candidates[] = {
+        0x300000000ull, 0x400000000ull, 0x800000000ull, 0x1000000000ull,
+        0x2000000000ull, 0x8000000000ull, 0x10000000000ull, 0x40000000000ull,
+    };
+    void* reservation = nullptr;
+    for (uintptr_t candidate : candidates) {
+        // The address is a hint: a range the kernel put elsewhere could be in the driver's way, so it
+        // is given back and the next address tried.
+        void* placed = reinterpret_cast<void*>(candidate);
+        if (sceKernelReserveVirtualRange(&placed, total, 0, PS5_KERNEL_DIRECT_ALIGNMENT) != 0) {
+            continue;
+        }
+        if (placed == reinterpret_cast<void*>(candidate)) {
+            reservation = placed;
+            break;
+        }
+        sceKernelMunmap(placed, total);
+    }
+    if (reservation == nullptr) {
+        fprintf(stderr, "[Recomp] No address range for rdram could be reserved\n");
+        return nullptr;
+    }
+
+    int64_t direct = 0;
+    int32_t result = sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), mem_size,
+        PS5_KERNEL_DIRECT_ALIGNMENT, PS5_KERNEL_DIRECT_TYPE_CPU, &direct);
+    if (result != 0) {
+        fprintf(stderr, "[Recomp] Allocating rdram's direct memory failed (0x%08X)\n", (unsigned)result);
+        sceKernelMunmap(reservation, total);
+        return nullptr;
+    }
+    uint8_t* const rdram = static_cast<uint8_t*>(reservation) + rdram_guard_size;
+    void* mapped = rdram;
+    result = sceKernelMapDirectMemory(&mapped, mem_size, PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE,
+        PS5_KERNEL_MAP_FIXED, direct, PS5_KERNEL_DIRECT_ALIGNMENT);
+    if (result != 0 || mapped != rdram) {
+        fprintf(stderr, "[Recomp] Mapping rdram's direct memory failed (0x%08X)\n", (unsigned)result);
+        sceKernelMunmap(reservation, total);  // takes any part of it that was mapped too
+        sceKernelReleaseDirectMemory(direct, mem_size);
+        return nullptr;
+    }
+    // Direct memory is not cleared when it is allocated, and rdram starts zeroed everywhere else.
+    memset(rdram, 0, mem_size);
+    printf("[Recomp] rdram at %p, %zu MiB of direct memory\n", static_cast<void*>(rdram), mem_size >> 20);
+    return rdram;
+}
 #endif
 
