-        indices.fill(0);
+        indices.fill(InvalidVertexIndex);
         used.reset();
         lights.fill({});
@@ -101,4 +102,23 @@ namespace RT64 {
     }
 
+    void RSP::invalidateVertices() {
+        indices.fill(InvalidVertexIndex);
+        used.reset();
+    }
+
+    // Whether a slot's index names a vertex of the workload being written. A display list in game
+    // memory can draw or modify a slot it never loaded, or one loaded before a full sync.
+    bool RSP::vertexIndexValid(uint32_t globalIndex) {
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        const Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        return globalIndex < workload.drawData.vertexCount();
+    }
+
+    void RSP::dropVertexCommand(const char *command) {
+        if (droppedVertexCommands++ == 0) {
+            fprintf(stderr, "RT64: dropped %s naming a vertex slot with no vertex loaded since the last full sync\n", command);
+        }
+    }
