+
+    // Draw tags: while on, a G_SPNOOP whose low 24 bits are RT64_DRAW_TAG_PUSH starts tagging the draw
+    // calls that follow with its second word (DrawCall::drawTag) until the matching RT64_DRAW_TAG_POP,
+    // and each draw call remembers the display list its triangles came from (DrawCall::drawList).
+    // Checked once per display list task. Safe to call from any thread.
+    void SetDrawTagging(bool enable);
+    bool GetDrawTagging();
+
+    // Called with each workload once its draw calls are complete, just before it is handed to the
+    // renderer, on the thread that processes display lists. A hook may set the calls' highlight colours.
+    struct Workload;
+    using WorkloadHook = void(Workload &workload);
+    void SetWorkloadHook(WorkloadHook *hook);
+    WorkloadHook *GetWorkloadHook();
+
+    // Where the last frame was presented: the window rectangle (swap chain pixels) the frame buffer
+    // of fbWidth x fbHeight native pixels covers, and the frame buffer's widening for the window's
+    // shape (resolution scale x over y). Safe to call from any thread.
+    struct PresentedPicture {
+        float x = 0.0f;
+        float y = 0.0f;
+        float width = 0.0f;
+        float height = 0.0f;
+        uint32_t swapChainWidth = 0;
+        uint32_t swapChainHeight = 0;
+        uint32_t fbWidth = 0;
+        uint32_t fbHeight = 0;
+        float widening = 1.0f;
+    };
+
+    void SetPresentedPicture(const PresentedPicture &picture);
+    bool GetPresentedPicture(PresentedPicture &picture);
 };
