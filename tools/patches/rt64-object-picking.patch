+    void State::beginDrawTags(uint32_t dlStartAddress) {
+        drawTagging = GetDrawTagging();
+        drawTagStack.clear();
+        drawListStack.clear();
+        if (drawTagging) {
+            drawListStack.push_back(dlStartAddress);
+            setDrawTagAndList(0, dlStartAddress);
+        }
+        else {
+            setDrawTagAndList(0, 0);
+        }
+    }
+
+    void State::pushDrawTag(uint32_t tag) {
+        if (drawTagging) {
+            drawTagStack.push_back(tag);
+            setDrawTagAndList(tag, drawCall.drawList);
+        }
+    }
+
+    void State::popDrawTag() {
+        if (drawTagging && !drawTagStack.empty()) {
+            drawTagStack.pop_back();
+            setDrawTagAndList(drawTagStack.empty() ? 0 : drawTagStack.back(), drawCall.drawList);
+        }
+    }
+
+    void State::enterDisplayList(uint32_t rdramAddress, bool push) {
+        if (drawTagging) {
+            if (push || drawListStack.empty()) {
+                drawListStack.push_back(rdramAddress);
+            }
+            else {
+                drawListStack.back() = rdramAddress;
+            }
+
+            setDrawTagAndList(drawCall.drawTag, rdramAddress);
+        }
+    }
+
+    void State::leaveDisplayList() {
+        if (drawTagging && !drawListStack.empty()) {
+            drawListStack.pop_back();
+            setDrawTagAndList(drawCall.drawTag, drawListStack.empty() ? 0 : drawListStack.back());
+        }
+    }
+
+    void State::setDrawTagAndList(uint32_t tag, uint32_t list) {
+        // Triangles recorded so far keep the tag and list they were drawn with.
+        if ((drawCall.drawTag != tag) || (drawCall.drawList != list)) {
+            flush();
+            drawCall.drawTag = tag;
+            drawCall.drawList = list;
+        }
+    }
+
     void State::setRefreshRate(uint16_t refreshRate) {
         extended.refreshRate = refreshRate;
     }
