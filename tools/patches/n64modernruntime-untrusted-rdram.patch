 void ultramodern::set_running_thread_address(PTR(PTR(OSThread)) address) {
     running_thread_address = address;
+}
+
+// Every thread's native context, by its OSThread. The OSThread lives in RDRAM, which a game snapshot
+// from another machine replaces whole, so its `context` field is believed only when it is the one this
+// run made for that OSThread: anything else stops the game before the pointer is used.
+static std::mutex thread_contexts_mutex;
+static std::unordered_map<const OSThread*, UltraThreadContext*> thread_contexts;
+
+static void set_thread_context(OSThread* t, UltraThreadContext* context) {
+    std::lock_guard lock{thread_contexts_mutex};
+    t->context = context;
+    if (context != nullptr) {
+        thread_contexts[t] = context;
+    } else {
+        thread_contexts.erase(t);
+    }
+}
+
+// The thread's context, nullptr for a destroyed thread.
+static UltraThreadContext* checked_context(const OSThread* t) {
+    UltraThreadContext* context = t->context;
+    if (context == nullptr) {
+        return nullptr;
+    }
+    {
+        std::lock_guard lock{thread_contexts_mutex};
+        const auto found = thread_contexts.find(t);
+        if (found != thread_contexts.end() && found->second == context) {
+            return context;
+        }
+    }
+    fprintf(stderr, "[ultramodern] A thread in game memory has a native context this run did not make for it: "
+                    "the game's memory is not one this run can trust. Stopping.\n");
+    ULTRAMODERN_QUICK_EXIT();
 }
 
