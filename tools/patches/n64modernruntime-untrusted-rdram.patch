 }
diff --git a/ultramodern/src/mesgqueue.cpp b/ultramodern/src/mesgqueue.cpp
--- a/ultramodern/src/mesgqueue.cpp
+++ b/ultramodern/src/mesgqueue.cpp
@@ -1,3 +1,4 @@
+#include <cstdio>
 #include <bitset>
 #include <thread>
 
@@ -67,8 +68,33 @@
     }
 }
 
+// A queue's fields live in RDRAM, which a game snapshot from another machine replaces whole, and they index
+// its message buffer natively (an index times 4 reaches far outside RDRAM's reservation): checked before
+// every use. The buffer must lie in the first 8 MiB of RDRAM (KSEG0) and the indices inside it.
+static bool buffer_ok(PTR(OSMesg) msg, s32 count) {
+    const uint64_t start = static_cast<uint32_t>(msg);
+    return count > 0 && start % 4 == 0 && start >= 0x80000000ull &&
+           start + 4ull * static_cast<uint64_t>(count) <= 0x80800000ull;
+}
+
+static bool queue_ok(const OSMesgQueue* mq) {
+    return buffer_ok(mq->msg, mq->msgCount) && mq->first >= 0 && mq->first < mq->msgCount && mq->validCount >= 0 &&
+           mq->validCount <= mq->msgCount;
+}
+
+[[noreturn]] static void bad_queue(PTR(OSMesgQueue) mq_) {
+    fprintf(stderr, "[ultramodern] The message queue at 0x%08X in game memory is not one the game can have made (its "
+                    "buffer or indices are out of range): the game's memory is not one this run can trust. Stopping.\n",
+            static_cast<uint32_t>(mq_));
+    ULTRAMODERN_QUICK_EXIT();
+}
+
 extern "C" void osCreateMesgQueue(RDRAM_ARG PTR(OSMesgQueue) mq_, PTR(OSMesg) msg, s32 count) {
     OSMesgQueue *mq = TO_PTR(OSMesgQueue, mq_);
+    // A queue with no slots never indexes its buffer; any other must have one in RDRAM.
+    if (count < 0 || (count > 0 && !buffer_ok(msg, count))) {
+        bad_queue(mq_);
+    }
     mq->blocked_on_recv = NULLPTR;
     mq->blocked_on_send = NULLPTR;
     mq->msgCount = count;
@@ -106,6 +132,9 @@
         }
     }
     
+    if (!queue_ok(mq)) {
+        bad_queue(mq_);
+    }
     if (jam) {
         // Jams insert at the head of the message queue's buffer.
         mq->first = (mq->first + mq->msgCount - 1) % mq->msgCount;
@@ -144,6 +173,9 @@
         }
     }
 
+    if (!queue_ok(mq)) {
+        bad_queue(mq_);
+    }
     if (msg_ != NULLPTR) {
