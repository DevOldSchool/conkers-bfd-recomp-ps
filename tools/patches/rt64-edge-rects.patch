+        uint32_t opaqueRows = 0;
+        for (int32_t row = firstRow; row <= lastRow; row++) {
+            rows++;
+            opaqueRows += opaque(texel(row)) ? 1 : 0;
+        }
+
+        return (rows > 0) && (opaqueRows * 3 >= rows * 2);
+    }
