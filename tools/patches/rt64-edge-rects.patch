+    // Whether a column of a tile is mostly opaque, read from the RDRAM it is loaded from: clamping to it past the
+    // tile's edge then carries on a solid edge (used by rect.extendEdgeRects). False if it cannot tell.
+    bool RDP::tileColumnOpaque(uint8_t tile, int32_t column) {
+        // Loads are carried out later, so find the latest one queued for this tile's TMEM address.
+        const LoadTile &renderTile = tiles[tile];
+        const Workload &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+        const auto &loadOps = workload.drawData.loadOperations;
+        const LoadOperation *found = nullptr;
+        for (size_t i = loadOps.size(); (i > 0) && (found == nullptr); i--) {
+            if ((loadOps[i - 1].tile.tmem == renderTile.tmem) && (loadOps[i - 1].type != LoadOperation::Type::TLUT)) {
+                found = &loadOps[i - 1];
+            }
+        }
+
+        if (found == nullptr) {
+            return false;
+        }
+
+        const LoadOperation &loadOp = *found;
+        const uint32_t bitsPerTexel = 4u << renderTile.siz;
+        uint32_t rdramStart, rowBytes;
+        if (loadOp.type == LoadOperation::Type::Block) {
+            rdramStart = loadOp.texture.address + ((loadOp.tile.uls >> 2) << loadOp.texture.siz >> 1) + (loadOp.texture.width << loadOp.texture.siz >> 1) * loadOp.tile.ult;
+            rowBytes = uint32_t(renderTile.line) << 3;
+        }
+        else if (loadOp.type == LoadOperation::Type::Tile) {
+            rowBytes = loadOp.texture.width << loadOp.texture.siz >> 1;
+            rdramStart = loadOp.texture.address + ((loadOp.tile.uls >> 2) << loadOp.texture.siz >> 1) + rowBytes * (loadOp.tile.ult >> 2);
+        }
+        else {
+            return false;
+        }
+
+        if ((rowBytes == 0) || (bitsPerTexel > 32) || (column < 0)) {
+            return false;
+        }
+
+        const int32_t firstRow = renderTile.ult >> 2;
+        const int32_t lastRow = std::min(int32_t(renderTile.lrt >> 2), firstRow + 255);
+        const uint32_t columnBits = uint32_t(column - (renderTile.uls >> 2)) * bitsPerTexel;
+        auto texel = [&](int32_t row) {
+            const uint32_t bitAddress = (rdramStart + uint32_t(row - firstRow) * rowBytes) * 8 + columnBits;
+            uint32_t value = 0;
+            for (uint32_t b = 0; b < std::max(bitsPerTexel / 8, 1u); b++) {
+                value = (value << 8) | state->RDRAM[maskAddress((bitAddress >> 3) + b) ^ 3];
+            }
+
+            if (bitsPerTexel == 4) {
+                value = (bitAddress & 4) ? (value & 0xF) : (value >> 4);
+            }
+
+            return value;
+        };
+
+        // Opaque by the tile's format; colour-indexed tiles are not decoded.
+        auto opaque = [&](uint32_t value) {
+            switch (renderTile.fmt) {
+            case G_IM_FMT_I:
+                return value >= ((bitsPerTexel == 4) ? 0x8u : 0x80u);
+            case G_IM_FMT_IA:
+                if (bitsPerTexel == 4) return (value & 0x1) != 0;
+                if (bitsPerTexel == 8) return (value & 0xF) >= 0x8;
+                return (value & 0xFF) >= 0x80;
+            case G_IM_FMT_RGBA:
+                return (bitsPerTexel == 16) ? ((value & 0x1) != 0) : ((value & 0xFF) >= 0x80);
+            default:
+                return false;
+            }
+        };
+
+        // Mostly opaque (two thirds or more): clamping to it carries on a solid edge, like the black outside a wipe's
+        // circle (whose edge column is clear only where the circle meets it). A mostly transparent edge would only
+        // smear its few visible texels.
