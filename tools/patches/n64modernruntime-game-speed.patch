+void ultramodern::set_speed_multiplier(uint32_t multiplier) {
+    std::lock_guard lock{speed_mutex};
+    const auto now = std::chrono::high_resolution_clock::now();
+    speed_base_game += (now - speed_base_real) * speed_multiplier.load();
+    speed_base_real = now;
+    speed_multiplier.store(multiplier < 1 ? 1 : multiplier);
+}
+
+std::chrono::high_resolution_clock::time_point ultramodern::game_time_to_real(std::chrono::high_resolution_clock::duration game_time) {
+    std::lock_guard lock{speed_mutex};
+    return speed_base_real + (game_time - speed_base_game) / speed_multiplier.load();
+}
