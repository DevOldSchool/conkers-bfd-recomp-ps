+                    (view.uly > fbPair.scissorRect.uly) || (view.lry < fbPair.scissorRect.lry);
+                if (!splitView || rect.isEmpty()) {
+                    continue;
+                }
+
+                // Within the view top to bottom (it may run past the view's sides), across most of its width.
+                const FixedRect inside = rect.intersection(view);
+                if (inside.isEmpty() || (inside.uly != rect.uly) || (inside.lry != rect.lry)) {
+                    continue;
+                }
