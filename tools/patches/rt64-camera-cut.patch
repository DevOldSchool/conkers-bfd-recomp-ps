+    static std::atomic<float> interpolationCutDistance{ 0.0f };
+    static std::atomic<float> interpolationCutDegrees{ 0.0f };
+
+    void SetInterpolationCameraCut(float distance, float degrees) {
+        interpolationCutDistance = distance;
+        interpolationCutDegrees = degrees;
+    }
+
+    bool IsInterpolationCameraCut(const hlslpp::float4x4 &prevView, const hlslpp::float4x4 &curView) {
+        const float cutDistance = interpolationCutDistance.load(std::memory_order_relaxed);
+        const float cutDegrees = interpolationCutDegrees.load(std::memory_order_relaxed);
+        if ((cutDistance <= 0.0f) && (cutDegrees <= 0.0f)) {
+            return false;
+        }
+
+        // The eye is where the view matrix takes the origin from: the translation of its inverse.
+        if (cutDistance > 0.0f) {
+            const hlslpp::float3 prevEye = hlslpp::inverse(prevView)[3].xyz;
+            const hlslpp::float3 curEye = hlslpp::inverse(curView)[3].xyz;
+            if (float(hlslpp::length(curEye - prevEye)) > cutDistance) {
+                return true;
+            }
+        }
+
+        if (cutDegrees > 0.0f) {
+            const hlslpp::float3x3 invPrevRotation = hlslpp::inverse(rotationFrom3x3(extract3x3(prevView)));
+            const hlslpp::float3x3 diffRotation = hlslpp::mul(invPrevRotation, rotationFrom3x3(extract3x3(curView)));
+            const float cosAngle = std::clamp((traceFrom3x3(diffRotation) - 1.0f) / 2.0f, -1.0f, 1.0f);
+            const float degrees = std::acos(cosAngle) * (180.0f / 3.14159265f);
+            if (degrees > cutDegrees) {
+                return true;
+            }
+        }
+
+        return false;
+    }
