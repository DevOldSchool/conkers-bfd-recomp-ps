+        // A game that rewrites a display list while it is being read leaves the interpreter in
+        // data that can branch back on itself, and the task would never finish. A frame runs to
+        // tens of thousands of commands, so stop a task far past that.
+        constexpr uint32_t CommandLimit = 1U << 22;
+        uint32_t commandCount = 0;
         while (dl != nullptr) {
+            if (++commandCount > CommandLimit) {
+                fprintf(stderr, "RT64: display list at 0x%08X stopped after %u commands, at 0x%08X\n",
+                    dlStartAdddress, CommandLimit, uint32_t(reinterpret_cast<uint8_t *>(dl) - state->RDRAM));
+                break;
+            }
