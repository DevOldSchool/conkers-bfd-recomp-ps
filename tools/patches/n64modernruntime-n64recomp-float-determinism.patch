+// The square root of a negative number is NaN, but which NaN differs: x86-64 makes 0xFFC00000 and
+// arm64 0x7FC00000. The game can keep it in memory, which online play compares, so every host makes
+// arm64's. (A NaN given in comes back as itself on both.)
+#ifndef __cplusplus
+static inline float recomp_sqrtf(float val) { return val < 0.0f ? __builtin_nanf("") : (sqrtf)(val); }
+static inline double recomp_sqrt(double val) { return val < 0.0 ? __builtin_nan("") : (sqrt)(val); }
+#define sqrtf(val) recomp_sqrtf(val)
+#define sqrt(val) recomp_sqrt(val)
+#endif
+
 #define NAN_CHECK(val) \
     assert(val == val)
 
