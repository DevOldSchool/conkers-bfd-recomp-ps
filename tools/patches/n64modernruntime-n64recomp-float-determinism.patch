 static inline int64_t do_cvt_l_d(double val) {
-    // Rounding mode aware double to 64-bit int conversion.
-    return (int64_t)llrint(val);
+    return recomp_to_l(nearbyint(val));
 }
 
 #define CVT_L_D(val) \
