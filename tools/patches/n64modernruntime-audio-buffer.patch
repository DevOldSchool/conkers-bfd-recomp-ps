     // Calculate the number of samples from the number of bytes.
     uint32_t sample_count = byte_count / sizeof(int16_t);
 
+    // The buffer and its size come from game memory. A frame of audio is a few KiB; refuse anything
+    // that is not a sane buffer inside RDRAM rather than copy (and queue) gigabytes.
+    constexpr uint32_t max_buffer_bytes = 0x10000;
+    const uint32_t address = static_cast<uint32_t>(audio_data_);
+    const bool in_kseg = address >= 0x80000000u && address < 0xC0000000u;  // cached or uncached
+    const uint32_t start = address & 0x1FFFFFFFu;
+    if (byte_count != 0 && (byte_count > max_buffer_bytes || !in_kseg || start + byte_count > 0x800000u)) {
+        fprintf(stderr, "[ultramodern] An audio buffer of 0x%X bytes at 0x%08X is not one the game can have made: the game's "
+                        "memory is not one this run can trust. Stopping.\n", byte_count, address);
+        ULTRAMODERN_QUICK_EXIT();
+    }
+
     // Queue the swapped audio data.
     if (sample_count > 0 && audio_callbacks.queue_samples) {
         audio_callbacks.queue_samples(TO_PTR(int16_t, audio_data_), sample_count);
